# 이 파일을 복사해서 .env로 저장한 뒤 각자 값을 채우세요.
# cp .env.example .env

# 카카오 디벨로퍼스 > 앱 설정 > 플랫폼 키 > JavaScript 키
EXPO_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# 영상 렌더링 서버 주소
# Railway에 배포된 서버 주소를 사용하세요 (팀 전체가 공용으로 사용 가능):
# https://lively-cooperation-production-c1b6.up.railway.app
#
# 만약 로컬 PC에서 mainServer.js를 직접 실행해서 테스트하고 싶다면,
# ipconfig(Windows) / ifconfig, ip addr(Mac·Linux)로 자신의 Wi-Fi IPv4 주소를 확인해서
# http://<내-PC-IP>:3000 형태로 채우세요 (폰과 PC가 같은 Wi-Fi여야 함).
EXPO_PUBLIC_SERVER_URL=https://lively-cooperation-production-c1b6.up.railway.app