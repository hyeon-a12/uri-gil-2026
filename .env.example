# 이 파일을 복사해서 .env로 저장한 뒤 각자 값을 채우세요.
# cp .env.example .env

# 카카오 디벨로퍼스 > 앱 설정 > 플랫폼 키 > JavaScript 키
EXPO_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# 영상 렌더링 서버 주소 (server/mainServer.js를 실행 중인 PC의 IP)
# ipconfig(Windows) / ifconfig, ip addr(Mac·Linux)로 자신의 Wi-Fi IPv4 주소를 확인해서 채우세요.
# 폰과 PC가 같은 Wi-Fi에 연결되어 있어야 합니다.
EXPO_PUBLIC_SERVER_URL=http://<내-PC-IP>:3000
